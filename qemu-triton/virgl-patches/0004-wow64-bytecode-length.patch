 #pragma GCC diagnostic ignored "-Wunused-parameter"
 #pragma GCC diagnostic ignored "-Wpointer-arith"
 
+/* WinBox: 32-bit (WoW64) guest apps send SIZE_T bytecode lengths with
+ * garbage in the upper half; no D3D11 bytecode is 4 GiB, so keep the low
+ * half. */
+static inline void
+npt_decode_SIZE_T_wow64(struct npt_cs_decoder *dec, SIZE_T *val)
+{
+    npt_decode_SIZE_T(dec, val);
+    if ((uint64_t)*val >> 32) {
+        static bool logged;
+        if (!logged) {
+            logged = true;
+            npt_log("32-bit guest SIZE_T 0x%016" PRIx64 ", using its low half",
+                    (uint64_t)*val);
+        }
+        *val = (SIZE_T)((uint64_t)*val & 0xffffffffu);
+    }
+}
+
