+typedef HRESULT (*PFN_vkd3d_open_existing_heap_from_host_pointer_fwd)(ID3D12Device *device,
+        void *address, UINT64 size, REFIID iid, void **heap);
+
+/* Forwarding stub for the host-pointer heap export (no-udmabuf hosts). */
+HRESULT DLLEXPORT vkd3d_open_existing_heap_from_host_pointer(ID3D12Device *device,
+        void *address, UINT64 size, REFIID iid, void **heap)
+{
+    static PFN_vkd3d_open_existing_heap_from_host_pointer_fwd pfn;
+
+    TRACE("device %p, address %p, size %"PRIu64", iid %s, heap %p.\n",
+            device, address, size, debugstr_guid(iid), heap);
+
+    if (!load_d3d12core())
+        return E_NOINTERFACE;
+
+    if (!pfn)
+        pfn = (PFN_vkd3d_open_existing_heap_from_host_pointer_fwd)vkd3d_dlsym(
+                d3d12core_module, "vkd3d_open_existing_heap_from_host_pointer");
+    if (!pfn)
+    {
+        ERR("d3d12core module lacks vkd3d_open_existing_heap_from_host_pointer.\n");
+        return E_NOTIMPL;
+    }
+
+    return pfn(device, address, size, iid, heap);
+}
 #endif /* !_WIN32 */
 
