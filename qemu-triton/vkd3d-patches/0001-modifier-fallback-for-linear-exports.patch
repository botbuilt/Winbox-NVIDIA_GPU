@@ -4611,6 +4754,34 @@ fail:
 }
 
 #ifndef _WIN32
+static uint32_t vkd3d_dmabuf_modifier_plane_count(struct d3d12_device *device,
+        VkFormat format, uint64_t modifier)
+{
+    const struct vkd3d_vk_instance_procs *vk_procs = &device->vkd3d_instance->vk_procs;
+    VkDrmFormatModifierPropertiesEXT *props;
+    VkDrmFormatModifierPropertiesListEXT list;
+    VkFormatProperties2 format_properties;
+    uint32_t i, planes = 0;
+
+    memset(&list, 0, sizeof(list));
+    list.sType = VK_STRUCTURE_TYPE_DRM_FORMAT_MODIFIER_PROPERTIES_LIST_EXT;
+    memset(&format_properties, 0, sizeof(format_properties));
+    format_properties.sType = VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_2;
+    format_properties.pNext = &list;
+    VK_CALL(vkGetPhysicalDeviceFormatProperties2(device->vk_physical_device, format, &format_properties));
+    if (!list.drmFormatModifierCount || !(props = vkd3d_calloc(list.drmFormatModifierCount, sizeof(*props))))
+        return 0;
+    list.pDrmFormatModifierProperties = props;
+    VK_CALL(vkGetPhysicalDeviceFormatProperties2(device->vk_physical_device, format, &format_properties));
+    for (i = 0; i < list.drmFormatModifierCount; i++)
+    {
+        if (props[i].drmFormatModifier == modifier)
+            planes = props[i].drmFormatModifierPlaneCount;
+    }
+    vkd3d_free(props);
+    return planes;
+}
