+#ifndef _WIN32
+#define VKD3D_DRM_FORMAT_MOD_LINEAR 0ull
+
+/* Can an image with these parameters be created with this DRM format
+ * modifier and shared as a dmabuf? */
+static bool vkd3d_dmabuf_modifier_usable(struct d3d12_device *device,
+        const VkImageCreateInfo *image_info, const VkDrmFormatModifierPropertiesEXT *props)
+{
+    const struct vkd3d_vk_instance_procs *vk_procs = &device->vkd3d_instance->vk_procs;
+    VkPhysicalDeviceImageDrmFormatModifierInfoEXT modifier_info;
+    VkPhysicalDeviceExternalImageFormatInfo external_info;
+    VkExternalImageFormatProperties external_properties;
+    VkPhysicalDeviceImageFormatInfo2 format_info;
+    VkImageFormatProperties2 format_properties;
+    VkExternalMemoryFeatureFlags required;
+    VkFormatFeatureFlags features = 0;
+
+    if (image_info->usage & VK_IMAGE_USAGE_SAMPLED_BIT)
+        features |= VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT;
+    if (image_info->usage & VK_IMAGE_USAGE_STORAGE_BIT)
+        features |= VK_FORMAT_FEATURE_STORAGE_IMAGE_BIT;
+    if (image_info->usage & VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT)
+        features |= VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT;
+    if (image_info->usage & VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT)
+        features |= VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT;
+    if (image_info->usage & VK_IMAGE_USAGE_TRANSFER_SRC_BIT)
+        features |= VK_FORMAT_FEATURE_TRANSFER_SRC_BIT;
+    if (image_info->usage & VK_IMAGE_USAGE_TRANSFER_DST_BIT)
+        features |= VK_FORMAT_FEATURE_TRANSFER_DST_BIT;
+
+    if ((props->drmFormatModifierTilingFeatures & features) != features)
+        return false;
+
+    memset(&modifier_info, 0, sizeof(modifier_info));
+    modifier_info.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_DRM_FORMAT_MODIFIER_INFO_EXT;
+    modifier_info.drmFormatModifier = props->drmFormatModifier;
+    modifier_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+
+    memset(&external_info, 0, sizeof(external_info));
+    external_info.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_IMAGE_FORMAT_INFO;
+    external_info.pNext = &modifier_info;
+    external_info.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+
+    memset(&format_info, 0, sizeof(format_info));
+    format_info.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_FORMAT_INFO_2;
+    format_info.pNext = &external_info;
+    format_info.format = image_info->format;
+    format_info.type = image_info->imageType;
+    format_info.tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT;
+    format_info.usage = image_info->usage;
+    format_info.flags = image_info->flags;
+
+    memset(&external_properties, 0, sizeof(external_properties));
+    external_properties.sType = VK_STRUCTURE_TYPE_EXTERNAL_IMAGE_FORMAT_PROPERTIES;
+    memset(&format_properties, 0, sizeof(format_properties));
+    format_properties.sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_PROPERTIES_2;
+    format_properties.pNext = &external_properties;
+
+    if (VK_CALL(vkGetPhysicalDeviceImageFormatProperties2(device->vk_physical_device,
+            &format_info, &format_properties)) != VK_SUCCESS)
+        return false;
+
+    required = VK_EXTERNAL_MEMORY_FEATURE_EXPORTABLE_BIT | VK_EXTERNAL_MEMORY_FEATURE_IMPORTABLE_BIT;
+    if ((external_properties.externalMemoryProperties.externalMemoryFeatures & required) != required)
+        return false;
+
+    return image_info->extent.width <= format_properties.imageFormatProperties.maxExtent.width &&
+            image_info->extent.height <= format_properties.imageFormatProperties.maxExtent.height &&
+            image_info->mipLevels <= format_properties.imageFormatProperties.maxMipLevels &&
+            image_info->arrayLayers <= format_properties.imageFormatProperties.maxArrayLayers;
+}
+
+/* A linear-requested dmabuf export stays LINEAR where the driver can share
+ * that layout.  Where it can't (NVIDIA offers no shareable LINEAR modifier
+ * for scanout formats), use the driver's own modifiers instead: the
+ * descriptor carries the modifier, so a modifier-aware importer such as
+ * DXVK still opens it.  DXVK's export path does the same. */
+static void vkd3d_select_dmabuf_modifiers(struct d3d12_device *device,
+        struct d3d12_resource *resource, struct vkd3d_image_create_info *create_info)
+{
+    const struct vkd3d_vk_instance_procs *vk_procs = &device->vkd3d_instance->vk_procs;
+    VkDrmFormatModifierPropertiesEXT *props = NULL;
+    VkImageCreateInfo *image_info = &create_info->image_info;
+    VkDrmFormatModifierPropertiesListEXT list;
+    VkFormatProperties2 format_properties;
+    uint32_t i, count = 0;
+    bool linear = false;
+
+    if (!device->vk_info.EXT_image_drm_format_modifier)
+        return;
+
+    memset(&list, 0, sizeof(list));
+    list.sType = VK_STRUCTURE_TYPE_DRM_FORMAT_MODIFIER_PROPERTIES_LIST_EXT;
+    memset(&format_properties, 0, sizeof(format_properties));
+    format_properties.sType = VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_2;
+    format_properties.pNext = &list;
+    VK_CALL(vkGetPhysicalDeviceFormatProperties2(device->vk_physical_device,
+            image_info->format, &format_properties));
+
+    if (!list.drmFormatModifierCount ||
+            !(props = vkd3d_calloc(list.drmFormatModifierCount, sizeof(*props))))
+        return;
+
+    list.pDrmFormatModifierProperties = props;
+    VK_CALL(vkGetPhysicalDeviceFormatProperties2(device->vk_physical_device,
+            image_info->format, &format_properties));
+
+    for (i = 0; i < list.drmFormatModifierCount; i++)
+    {
+        if (!vkd3d_dmabuf_modifier_usable(device, image_info, &props[i]))
+            continue;
+        if (props[i].drmFormatModifier == VKD3D_DRM_FORMAT_MOD_LINEAR)
+            linear = true;
+        else if (count < ARRAY_SIZE(create_info->modifiers))
+            create_info->modifiers[count++] = props[i].drmFormatModifier;
+    }
+    vkd3d_free(props);
+
+    if (linear || !count)
+        return;
+
+    WARN("No shareable LINEAR layout for format %u, usage %#x; exporting with %u driver modifier(s).\n",
+            image_info->format, image_info->usage, count);
+
+    create_info->modifier_list.sType = VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_LIST_CREATE_INFO_EXT;
+    create_info->modifier_list.drmFormatModifierCount = count;
+    create_info->modifier_list.pDrmFormatModifiers = create_info->modifiers;
+    vk_prepend_struct(image_info, &create_info->modifier_list);
+    image_info->tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT;
+    resource->flags |= VKD3D_RESOURCE_DMABUF_MODIFIER;
+}
+#endif
