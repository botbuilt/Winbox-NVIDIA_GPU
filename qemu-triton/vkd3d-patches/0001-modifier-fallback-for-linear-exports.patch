 static HRESULT d3d12_resource_build_native_shared_descriptor(struct d3d12_resource *resource,
         struct d3d12_device *device, dxn_shared_texture **out_descriptor)
 {
@@ -4619,6 +4790,7 @@ static HRESULT d3d12_resource_build_native_shared_descriptor(struct d3d12_resour
     VkImageSubresource subresource;
     VkMemoryGetFdInfoKHR fd_info;
     VkSubresourceLayout layout;
+    unsigned int plane;
     int fd = -1;
     VkResult vr;
 
@@ -4672,10 +4844,6 @@ static HRESULT d3d12_resource_build_native_shared_descriptor(struct d3d12_resour
         return E_OUTOFMEMORY;
     }
 
-    memset(&subresource, 0, sizeof(subresource));
-    subresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
-    VK_CALL(vkGetImageSubresourceLayout(device->vk_device, resource->res.vk_image, &subresource, &layout));
-
     DXN_SHARED_INIT(descriptor, DXN_SHARED_TEXTURE_MAGIC);
 
     descriptor->meta.width = resource->desc.Width;
@@ -4693,8 +4861,44 @@ static HRESULT d3d12_resource_build_native_shared_descriptor(struct d3d12_resour
 
     descriptor->drm_modifier = 0; /* DRM_FORMAT_MOD_LINEAR */
     descriptor->plane_count = 1;
-    descriptor->planes[0].offset = layout.offset;
-    descriptor->planes[0].pitch = layout.rowPitch;
+
+    if (resource->flags & VKD3D_RESOURCE_DMABUF_MODIFIER)
+    {
+        VkImageDrmFormatModifierPropertiesEXT modifier_props;
+
+        memset(&modifier_props, 0, sizeof(modifier_props));
+        modifier_props.sType = VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_PROPERTIES_EXT;
+        if ((vr = VK_CALL(vkGetImageDrmFormatModifierPropertiesEXT(device->vk_device,
+                resource->res.vk_image, &modifier_props))) < 0)
+        {
+            ERR("Failed to query the image's DRM format modifier, vr %d.\n", vr);
+            vkd3d_free(descriptor);
+            close(fd);
+            return hresult_from_vk_result(vr);
+        }
+        descriptor->drm_modifier = modifier_props.drmFormatModifier;
+        descriptor->plane_count = vkd3d_dmabuf_modifier_plane_count(device,
+                resource->format->vk_format, modifier_props.drmFormatModifier);
+        if (!descriptor->plane_count || descriptor->plane_count > DXN_SHARED_MAX_PLANES)
+        {
+            ERR("Unexpected plane count %u for DRM format modifier %#"PRIx64".\n",
+                    descriptor->plane_count, (uint64_t)modifier_props.drmFormatModifier);
+            vkd3d_free(descriptor);
+            close(fd);
+            return E_FAIL;
+        }
+    }
+
+    for (plane = 0; plane < descriptor->plane_count; plane++)
+    {
+        memset(&subresource, 0, sizeof(subresource));
+        subresource.aspectMask = (resource->flags & VKD3D_RESOURCE_DMABUF_MODIFIER)
+                ? (VkImageAspectFlags)(VK_IMAGE_ASPECT_MEMORY_PLANE_0_BIT_EXT << plane)
+                : VK_IMAGE_ASPECT_COLOR_BIT;
+        VK_CALL(vkGetImageSubresourceLayout(device->vk_device, resource->res.vk_image, &subresource, &layout));
+        descriptor->planes[plane].offset = layout.offset;
+        descriptor->planes[plane].pitch = layout.rowPitch;
+    }
     descriptor->size = resource->mem.device_allocation.size;
     descriptor->fd = fd;
 
