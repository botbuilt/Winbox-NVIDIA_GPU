+        edpy->dirty_x1 = 0;
+        edpy->dirty_y1 = 0;
+        edpy->dirty_x2 = surface_width(new_surface);
+        edpy->dirty_y2 = surface_height(new_surface);
+        edpy->dirty = true;
+    }
 }
 
