+/*
+ * WinBox: true when VNC displays exist and none has a client, so a GL
+ * display can skip copying frames that nobody will see.
+ */
+bool vnc_display_idle(void)
+{
+    VncDisplay *vd;
+
+    if (QTAILQ_EMPTY(&vnc_displays)) {
+        return false;
+    }
+    QTAILQ_FOREACH(vd, &vnc_displays, next) {
+        if (!QTAILQ_EMPTY(&vd->clients)) {
+            return false;
+        }
+    }
+    return true;
+}
