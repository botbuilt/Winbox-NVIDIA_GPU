@@ -37,6 +97,15 @@ static void egl_gfx_switch(DisplayChangeListener *dcl,
     egl_dpy *edpy = container_of(dcl, egl_dpy, dcl);
 
     edpy->ds = new_surface;
+
+    /* A new surface starts blank: copy the whole frame into it. */
