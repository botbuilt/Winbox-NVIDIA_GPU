diff --git a/ui/egl-headless.c b/ui/egl-headless.c
index ef5cc02..ea5bef4 100644
--- a/ui/egl-headless.c
+++ b/ui/egl-headless.c
@@ -17,13 +17,73 @@ typedef struct egl_dpy {
     bool y_0_top;
     uint32_t pos_x;
     uint32_t pos_y;
+    /*
+     * WinBox: a guest flush only marks the frame dirty; egl_refresh copies
+     * it to the 2D surface once per refresh tick (30 ms), and only while a
+     * VNC client is connected.  The copy ends in a synchronous glReadPixels
+     * of the whole screen on the main thread, which used to run for every
+     * guest frame even with nobody watching the console.
+     */
+    bool dirty;
+    uint32_t dirty_x1, dirty_y1, dirty_x2, dirty_y2;
+    EGLContext flush_ctx;
 } egl_dpy;
 
 /* ------------------------------------------------------------------ */
 
+static void egl_readback(egl_dpy *edpy)
+{
+    EGLContext cur = eglGetCurrentContext();
+
+    edpy->dirty = false;
+    if (!edpy->guest_fb.texture || !edpy->ds || !edpy->flush_ctx) {
+        return;
+    }
+    assert(surface_format(edpy->ds) == PIXMAN_x8r8g8b8);
+
+    /*
+     * Framebuffer objects are not shared between contexts, so use the
+     * context the flush came in on, then give the caller its own back.
+     */
+    if (cur != edpy->flush_ctx &&
+        !eglMakeCurrent(qemu_egl_display, EGL_NO_SURFACE, EGL_NO_SURFACE,
+                        edpy->flush_ctx)) {
+        return;
+    }
+
+    if (edpy->cursor_fb.texture) {
+        /* have cursor -> render using textures */
+        egl_texture_blit(edpy->gls, &edpy->blit_fb, &edpy->guest_fb,
+                         !edpy->y_0_top);
+        egl_texture_blend(edpy->gls, &edpy->blit_fb, &edpy->cursor_fb,
+                          !edpy->y_0_top, edpy->pos_x, edpy->pos_y,
+                          1.0, 1.0);
+    } else {
+        /* no cursor -> use simple framebuffer blit */
+        egl_fb_blit(&edpy->blit_fb, &edpy->guest_fb, edpy->y_0_top);
+    }
+
+    egl_fb_read(edpy->ds, &edpy->blit_fb);
+
+    if (cur != edpy->flush_ctx) {
+        eglMakeCurrent(qemu_egl_display, EGL_NO_SURFACE, EGL_NO_SURFACE, cur);
+    }
+
+    dpy_gfx_update(edpy->dcl.con, edpy->dirty_x1, edpy->dirty_y1,
+                   edpy->dirty_x2 - edpy->dirty_x1,
+                   edpy->dirty_y2 - edpy->dirty_y1);
+}
+
 static void egl_refresh(DisplayChangeListener *dcl)
 {
+    egl_dpy *edpy = container_of(dcl, egl_dpy, dcl);
+
     graphic_hw_update(dcl->con);
+
+    /* Nobody watching: keep the frame dirty for the next viewer. */
+    if (edpy->dirty && !vnc_display_idle()) {
+        egl_readback(edpy);
+    }
 }
 
