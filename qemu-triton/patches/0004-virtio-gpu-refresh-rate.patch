diff --git a/hw/display/virtio-gpu-base.c b/hw/display/virtio-gpu-base.c
index 7827536..9bc2ee3 100644
--- a/hw/display/virtio-gpu-base.c
+++ b/hw/display/virtio-gpu-base.c
@@ -64,6 +64,18 @@ virtio_gpu_base_generate_edid(VirtIOGPUBase *g, int scanout,
         .refresh_rate = g->req_state[scanout].refresh_rate,
     };
 
+    /*
+     * WinBox: only GTK reports the host monitor's rate. Headless displays
+     * (VNC, egl-headless) take the refresh_rate property instead, so the
+     * guest can run above the 75 Hz the EDID defaults to. Values below
+     * 1000 are Hz, anything else mHz like the EDID properties of the other
+     * display devices.
+     */
+    if (!info.refresh_rate && g->conf.refresh_rate) {
+        info.refresh_rate = g->conf.refresh_rate < 1000 ?
+            g->conf.refresh_rate * 1000 : g->conf.refresh_rate;
+    }
+
     edid->size = cpu_to_le32(sizeof(edid->edid));
     qemu_edid_generate(edid->edid, sizeof(edid->edid), &info);
 }
