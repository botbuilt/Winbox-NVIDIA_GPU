diff --git a/include/ui/winbox-stream.h b/include/ui/winbox-stream.h
new file mode 100644
index 0000000..b964341
--- /dev/null
+++ b/include/ui/winbox-stream.h
@@ -0,0 +1,119 @@
+/*
+ * WinBox stream socket: hands the guest's scanout to a host-side streamer
+ * (Sunshine) and takes its keyboard and mouse input.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef UI_WINBOX_STREAM_H
+#define UI_WINBOX_STREAM_H
+
+#include "ui/console.h"
+
+/*
+ * Wire protocol.  The socket is AF_UNIX SOCK_SEQPACKET, so every message
+ * arrives whole: a WbsHeader, then `size` bytes of payload.  All fields are
+ * host-endian.  WBS_SCANOUT carries the scanout's dmabuf as SCM_RIGHTS.
+ */
+#define WBS_VERSION 1
+
+enum {
+    /* QEMU -> client */
+    WBS_HELLO = 1,      /* WbsHello */
+    WBS_SCANOUT = 2,    /* WbsScanout + dmabuf fd */
+    WBS_DISABLE = 3,    /* no payload: nothing is scanned out */
+    WBS_FRAME = 4,      /* WbsFrame: the guest flushed the scanout */
+    WBS_CURSOR = 5,     /* WbsCursor + width * height ARGB8888 pixels */
+    WBS_MOUSE = 6,      /* WbsMouse */
+
+    /* client -> QEMU */
+    WBS_KEY = 16,       /* WbsKey */
+    WBS_ABS = 17,       /* WbsAbs */
+    WBS_REL = 18,       /* WbsRel */
+    WBS_BUTTON = 19,    /* WbsButton */
+    WBS_WHEEL = 20,     /* WbsWheel */
+};
+
+typedef struct WbsHeader {
+    uint32_t type;
+    uint32_t size;
+} WbsHeader;
+
+typedef struct WbsHello {
+    uint32_t version;
+} WbsHello;
+
+typedef struct WbsScanout {
+    uint32_t width;     /* buffer size */
+    uint32_t height;
+    uint32_t stride;
+    uint32_t fourcc;    /* DRM format */
+    uint64_t modifier;  /* DRM format modifier */
+    uint32_t x;         /* visible rectangle in the buffer */
+    uint32_t y;
+    uint32_t w;
+    uint32_t h;
+    uint32_t y0_top;
+    uint32_t serial;    /* changes with every scanout */
+} WbsScanout;
+
+typedef struct WbsFrame {
+    uint32_t serial;    /* scanout the flush was for */
+    uint32_t seq;
+} WbsFrame;
+
+typedef struct WbsCursor {
+    uint32_t width;
+    uint32_t height;
+    int32_t hot_x;
+    int32_t hot_y;
+} WbsCursor;
+
+typedef struct WbsMouse {
+    int32_t x;          /* hotspot position */
+    int32_t y;
+    uint32_t visible;
+} WbsMouse;
+
+#define WBS_KEY_DOWN     1u
+#define WBS_KEY_EXTENDED 2u
+
+typedef struct WbsKey {
+    uint32_t vk;        /* Windows virtual-key code */
+    uint32_t flags;     /* WBS_KEY_* */
+} WbsKey;
+
+#define WBS_ABS_MAX 0x7fff
+
+typedef struct WbsAbs {
+    uint32_t x;         /* 0 .. WBS_ABS_MAX across the screen */
+    uint32_t y;
+} WbsAbs;
+
+typedef struct WbsRel {
+    int32_t dx;
+    int32_t dy;
+} WbsRel;
+
+typedef struct WbsButton {
+    uint32_t button;    /* 1 left, 2 middle, 3 right, 4 back, 5 forward */
+    uint32_t down;
+} WbsButton;
+
+typedef struct WbsWheel {
+    int32_t dy;         /* notches, positive scrolls up */
+    int32_t dx;         /* notches, positive scrolls right */
+} WbsWheel;
+
+void wbs_init(QemuConsole *con);
+void wbs_scanout_dmabuf(QemuConsole *con, QemuDmaBuf *dmabuf);
+void wbs_scanout_texture(QemuConsole *con, uint32_t tex_id, bool y0_top,
+                         uint32_t width, uint32_t height,
+                         uint32_t x, uint32_t y, uint32_t w, uint32_t h);
+void wbs_scanout_disable(QemuConsole *con);
+void wbs_release_dmabuf(QemuConsole *con, QemuDmaBuf *dmabuf);
+void wbs_flush(QemuConsole *con);
+void wbs_cursor_define(QemuConsole *con, QEMUCursor *cursor);
+void wbs_mouse_set(QemuConsole *con, int x, int y, bool on);
+
+#endif
