@@ -647,11 +652,40 @@ end:
     // (NullRendering, empty bodies) have no DPC callback and retire here.
     NotifyCompletion();
 
-    m_pCommander->CommandFinished();
+    // A tail-parked command already gave its slot back.
+    if (!m_SlotReleased)
