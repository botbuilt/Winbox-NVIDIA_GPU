@@ -442,6 +446,7 @@ void VioGpuCommand::Run()
                     RtlCopyMemory(&token, cmdBody, sizeof(token));
                     AddPending();
                     m_pAdapter->PresentWaitConsume(token, VioGpuCommand::QueueRunningCb, this, m_FenceId);
+                    ReleaseSlotIfTail();
