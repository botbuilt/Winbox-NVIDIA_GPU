     delete this;
 }
 
+void VioGpuCommand::ReleaseSlotIfTail()
+{
+    PAGED_CODE();
+
+    // Only once nothing of the body is left to run: a command with more body
+    // after the park point still has host commands to issue, and letting a
+    // later packet's commands reach the virtqueue first would reorder them.
+    // At the tail the host has every command of this packet already (the
+    // ctrl queue is FIFO) or none at all (GATE / PRESENT_WAIT never touch
+    // virtio), so a later packet may run now.  Its fence still reports only
+    // after this one's: the completion-contiguity window in
+    // ReportCompletedSyncRoutine raises the highest CONTIGUOUS id.  The
+    // preempt target (PreemptHold) stays the highest id ever started, so a
+    // preempt still acks only once everything started has completed.
+    //
+    // The parked completion may already have fired and re-queued this
+    // command; that is fine, only this worker thread runs or frees it.
+    if (m_SlotReleased || m_pCommand < m_pEnd)
+    {
+        return;
+    }
+    m_SlotReleased = TRUE;
+    m_pCommander->ReleaseSlot();
+}
+
 void VioGpuCommand::Discard()
 {
     PAGED_CODE();
@@ -1002,6 +1036,18 @@ void VioGpuCommander::CommandFinished()
     KeSetEvent(&m_QueueEvent, IO_NO_INCREMENT, FALSE);
 }
 
+void VioGpuCommander::ReleaseSlot()
+{
+    PAGED_CODE();
+    DbgPrint(TRACE_LEVEL_VERBOSE, ("<---> %s", __FUNCTION__));
+
+    // Same worker-thread-only accounting as CommandFinished; the event makes
+    // the worker go back for the next submitted packet as soon as the
+    // running queue drains.
+    m_running--;
+    KeSetEvent(&m_QueueEvent, IO_NO_INCREMENT, FALSE);
+}
+
 PAGED_CODE_SEG_END
 
 #pragma code_seg(push)
