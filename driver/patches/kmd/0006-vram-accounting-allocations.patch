+
+// Segment 3 stands for the host GPU memory the guest's host-only textures
+// and buffers use.  It is GPU address space only: not CPU-visible (so the
+// video memory manager can never zero or copy it through the CPU, which
+// would trap into QEMU on every access of the unbacked shmem window), and
+// nothing ever reads or writes it; its FILL/TRANSFER paging operations are
+// no-ops.  The UMD places one accounting allocation per large resource here,
+// so Windows' local usage and budget (QueryVideoMemoryInfo, Task Manager's
+// "Dedicated GPU memory") follow what apps really hold on the host GPU, and
+// games trim their texture streaming.  Sized like the shmem window
+// (VRAM_SIZE), the setting that already says how much GPU memory Windows
+// may use.
+template <typename DESC> void VioGpuAdapter::FillAccountSegment(DESC *pDesc)
+{
+    pDesc->BaseAddress.QuadPart = VioGpuAdapter::ACCOUNT_GPU_BASE_VA;
+    pDesc->Size = m_VioDev.shmem.length;
+    pDesc->CommitLimit = m_VioDev.shmem.length;
+    pDesc->Flags.Aperture = FALSE;
+    pDesc->Flags.CacheCoherent = TRUE;
+    pDesc->Flags.CpuVisible = FALSE;
+    if (g_VramSegmentMode >= 3)
+    {
+        pDesc->Flags.LocalBudgetGroup = TRUE;
+    }
 }
 
