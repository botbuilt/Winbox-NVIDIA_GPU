diff --git a/viogpu/viogpu3d/viogpu_adapter.cpp b/viogpu/viogpu3d/viogpu_adapter.cpp
index e8d4216..737849c 100644
--- a/viogpu/viogpu3d/viogpu_adapter.cpp
+++ b/viogpu/viogpu3d/viogpu_adapter.cpp
@@ -909,6 +909,18 @@ NTSTATUS VioGpuAdapter::QueryDeviceDescriptor(_In_ ULONG ChildUid, _Inout_ DXGK_
 // The segment topology shared by DXGKQAITYPE_QUERYSEGMENT3 and 4: segment 1
 // is the CPU-invisible aperture, optional segment 2 the CPU-visible host
 // shmem window.
+
+// Windows 10 (build 19045 checked) VidMm's InitPagingProcessVaSpace maps the
+// first paging buffers into the paging process through their segment
+// allocation without a NULL check, so a system-memory paging pool bugchecks
+// 0x7E in dxgmms2 at adapter start.  Windows 11 handles segment 0.
+static BOOLEAN VioGpuPagingPoolNeedsSegment()
+{
+    RTL_OSVERSIONINFOW ver = {};
+    ver.dwOSVersionInfoSize = sizeof(ver);
+    return NT_SUCCESS(RtlGetVersion(&ver)) && ver.dwBuildNumber < 22000;
+}
+
 template <typename SEGMENTOUT> static void FillPagingBufferInfo(SEGMENTOUT *pSegmentInfo)
 {
     // Room for the monitored-fence deferral to stamp a VIOGPU_DMA_PRIVATE
@@ -919,8 +931,11 @@ template <typename SEGMENTOUT> static void FillPagingBufferInfo(SEGMENTOUT *pSeg
     // 0 = paging buffers from SYSTEM memory.  Segment 1 is the CPU-INVISIBLE
     // aperture: pointing the paging pool there leaves
     // VIDMM_DMA_POOL::BeginCPUAccess with nothing to map, and every TDR's
-    // debug-info collection bugchecks 0x7E instead of recovering.
-    pSegmentInfo->PagingBufferSegmentId = 0;
+    // debug-info collection bugchecks 0x7E instead of recovering.  Windows 10
+    // needs the aperture anyway: it maps paging buffers through their system
+    // pages, and its memory-segment MapPagingBuffer is unimplemented (a
+    // shmem paging pool fails adapter start with Code 43).
+    pSegmentInfo->PagingBufferSegmentId = VioGpuPagingPoolNeedsSegment() ? 1 : 0;
     pSegmentInfo->PagingBufferSize = 10 * PAGE_SIZE;
 }
 
