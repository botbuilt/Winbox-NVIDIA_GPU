+void VioGpuAdapter::CompleteCopyNodeFence(UINT fenceId, UINT node, UINT engine)
+{
+    InterlockedExchange(&m_CopyNodeFenceId, (LONG)fenceId);
+    DXGKARGCB_NOTIFY_INTERRUPT_DATA interrupt = {};
+    interrupt.InterruptType = DXGK_INTERRUPT_DMA_COMPLETED;
+    interrupt.DmaCompleted.SubmissionFenceId = fenceId;
+    interrupt.DmaCompleted.NodeOrdinal = node;
+    interrupt.DmaCompleted.EngineOrdinal = engine;
+    NotifyInterrupt(&interrupt, TRUE);
+}
+
+void VioGpuAdapter::PreemptCopyNode(UINT preemptFenceId, UINT node, UINT engine)
+{
+    // Nothing is ever queued on the copy node, so every packet up to the last
+    // submitted one has completed and the preempt acks immediately.
+    DXGKARGCB_NOTIFY_INTERRUPT_DATA interrupt = {};
+    interrupt.InterruptType = DXGK_INTERRUPT_DMA_PREEMPTED;
+    interrupt.DmaPreempted.PreemptionFenceId = preemptFenceId;
+    interrupt.DmaPreempted.LastCompletedFenceId = (UINT)InterlockedOr(&m_CopyNodeFenceId, 0);
+    interrupt.DmaPreempted.NodeOrdinal = node;
+    interrupt.DmaPreempted.EngineOrdinal = engine;
+    NotifyInterrupt(&interrupt, TRUE);
+}
