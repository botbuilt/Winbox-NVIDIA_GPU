diff --git a/src/virtio/neptune/npt_env.h b/src/virtio/neptune/npt_env.h
index e43dbac..ce95cfb 100644
--- a/src/virtio/neptune/npt_env.h
+++ b/src/virtio/neptune/npt_env.h
@@ -87,6 +87,9 @@ struct npt_env {
     * (waiting for a pool thread -- head-of-line pressure) and wait_us
     * (the fence itself).  0 = off. */
    uint32_t event_waiter_trace_ms; /* NPT_EVENT_WAITER_TRACE */
+   /* WinBox: how long the host polls an empty primary ring before it
