  */
 
 #include "npt_ring.h"
+#include "npt_env.h"
 #include "npt_workaround.h"
 #include "npt_device.h"
 #include "npt_profile.h"
@@ -22,8 +23,13 @@ static_assert(ATOMIC_INT_LOCK_FREE >= 1 && sizeof(atomic_uint) == 4,
 static void
 npt_ring_notify(struct npt_ring *ring);
 
-#define NPT_RING_IDLE_TIMEOUT_NS (1000000) /* 1ms */
-/* TLS rings park 10x longer than the primary ring's 1ms idle so
+/* WinBox: the primary ring's idle timeout comes from NPT_RING_IDLE_MS
+ * (npt_env.c, default 8 ms; it was a fixed 1 ms).  Every submit that
+ * follows the previous one by more than the timeout rings the doorbell,
+ * an escape into the kernel driver and a virtio round trip to the host,
+ * so at 1 ms nearly every frame paid one.  The host spends the extra
+ * idle time in its sleeping relax loop, which costs it little. */
+/* TLS rings park 10x longer than the upstream primary ring's 1ms idle so
  * worker-thread traffic doesn't churn the host wakeup path.  +9ms
  * worst-case first-submit-after-park latency. */
 #define NPT_TLS_RING_IDLE_TIMEOUT_NS (10000000) /* 10ms */
@@ -1519,9 +1525,10 @@ npt_ring_create(struct npt_device *device,
    create_cmd.buffer_size = layout->buffer_size;
    create_cmd.extra_offset = layout->extra_offset;
    create_cmd.extra_size = layout->extra_size;
+   npt_env_init();
    create_cmd.idle_timeout = is_tls_ring
                                 ? NPT_TLS_RING_IDLE_TIMEOUT_NS
-                                : NPT_RING_IDLE_TIMEOUT_NS;
+                                : (uint64_t)npt_env.ring_idle_ms * 1000000;
    /* 10% early: a tick-rate error may cost a doorbell, never miss one. */
    ring->doorbell_idle_ticks =
       create_cmd.idle_timeout / 1000 * npt_ring_tick_hz() / 1000000 * 9 / 10;
