+/* ---------- VRAM accounting ---------- */
+
+/* pid<<32 | counter keeps bits 62/63 clear for the KMD's namespaces; bit 31
+ * of the counter word separates this minter from the transport's
+ * (npt_mint_alloc_cookie) in the same process. */
+ULONGLONG
+tritonKmMintAllocCookie(void)
+{
+   static volatile LONG counter;
+   return ((ULONGLONG)GetCurrentProcessId() << 32) | 0x80000000ull |
+          ((ULONG)InterlockedIncrement(&counter) & 0x7fffffffu);
+}
+
+/* Bytes per texel, or per 4x4 block for block-compressed formats
+ * (*pBlock set).  Unknown formats count as 4 bytes per texel. */
+static UINT
+tritonKmFormatBytes(DXGI_FORMAT f, BOOL *pBlock)
+{
+   *pBlock = FALSE;
+   const UINT v = (UINT)f;
+   if (v >= 1 && v <= 4)   return 16;  /* R32G32B32A32 */
+   if (v >= 5 && v <= 8)   return 12;  /* R32G32B32 */
+   if (v >= 9 && v <= 22)  return 8;   /* R16G16B16A16, R32G32, R32G8X24 */
+   if (v >= 23 && v <= 47) return 4;   /* R10G10B10A2 .. X24_G8 */
+   if (v >= 48 && v <= 59) return 2;   /* R8G8, R16, D16 */
+   if (v >= 60 && v <= 66) return 1;   /* R8, A8, R1 */
+   if (v >= 67 && v <= 69) return 4;   /* R9G9B9E5, packed 4:2:2 RGB */
+   if ((v >= 70 && v <= 72) || (v >= 79 && v <= 81)) {
+      *pBlock = TRUE;                   /* BC1, BC4 */
+      return 8;
+   }
+   if ((v >= 73 && v <= 78) || (v >= 82 && v <= 84) || (v >= 94 && v <= 99)) {
+      *pBlock = TRUE;                   /* BC2, BC3, BC5, BC6H, BC7 */
+      return 16;
+   }
+   if (v == 85 || v == 86) return 2;   /* B5G6R5, B5G5R5A1 */
+   if (v >= 87 && v <= 93) return 4;   /* B8G8R8A8/X8 family */
+   if (v == 115) return 2;             /* B4G4R4A4 */
+   return 4;
+}
+
+UINT64
+tritonKmEstimateResourceBytes(const D3D11DDIARG_CREATERESOURCE *a)
+{
+   if (!a->pMipInfoList || a->MipLevels == 0)
+      return 0;
+   if (a->ResourceDimension == D3D10DDIRESOURCE_BUFFER ||
+       a->ResourceDimension == D3D11DDIRESOURCE_BUFFEREX)
+      return a->pMipInfoList[0].TexelWidth;
+
+   BOOL block;
+   const UINT64 bpe = tritonKmFormatBytes(a->Format, &block);
+   UINT64 perSlice = 0;
+   for (UINT m = 0; m < a->MipLevels; m++) {
+      UINT64 w = a->pMipInfoList[m].TexelWidth  ? a->pMipInfoList[m].TexelWidth  : 1;
+      UINT64 h = a->pMipInfoList[m].TexelHeight ? a->pMipInfoList[m].TexelHeight : 1;
+      UINT64 d = a->pMipInfoList[m].TexelDepth  ? a->pMipInfoList[m].TexelDepth  : 1;
+      if (block) {
+         w = (w + 3) / 4;
+         h = (h + 3) / 4;
+      }
+      perSlice += w * h * d * bpe;
+   }
+   UINT64 slices = a->ArraySize ? a->ArraySize : 1;
+   if (a->ResourceDimension == D3D10DDIRESOURCE_TEXTURECUBE && a->ArraySize == 0)
+      slices = 6;
+   const UINT64 samples = a->SampleDesc.Count ? a->SampleDesc.Count : 1;
+   return perSlice * slices * samples;
+}
+
+/* Below this a resource is not counted: small buffers and textures come and
+ * go by the thousand and add up to little next to the large textures that
+ * make up a game's memory use. */
+#define TRITON_KM_ACCOUNT_MIN_BYTES (128u * 1024u)
+
+static BOOL
+tritonKmAccountingEnabled(void)
+{
+   static volatile LONG state; /* 0 unknown, 1 on, 2 off */
+   LONG s = state;
+   if (s == 0) {
+      char buf[8] = {0};
+      DWORD n = GetEnvironmentVariableA("NPT_VRAM_ACCOUNT", buf, sizeof(buf));
+      s = (n > 0 && n < sizeof(buf) && buf[0] == '0') ? 2 : 1;
+      InterlockedExchange(&state, s);
+   }
+   return s == 1;
+}
+
+/* Process-wide accounting statistics, reported through OutputDebugString
+ * (DebugView, "Capture Win32") so a user can see whether a game's memory is
+ * being counted and whether it is ever given back:
+ *   - the first few failures of each kind, with the HRESULT;
+ *   - a summary line each time the live counted size crosses another
+ *     256 MB step, up or down. */
+static volatile LONG64 g_AccLive;      /* bytes currently counted */
+static volatile LONG64 g_AccLiveCount; /* allocations currently counted */
+static volatile LONG   g_AccOk, g_AccAllocFail, g_AccResFail, g_AccPending;
+static volatile LONG   g_AccNoQueue, g_AccStep;
+
+#define TRITON_KM_ACCOUNT_LOG_STEP (256ull << 20)
+
+static void
+tritonKmAccountReport(const char *why)
+{
+   const LONG64 live = g_AccLive;
+   const LONG step = (LONG)(live / (LONG64)TRITON_KM_ACCOUNT_LOG_STEP);
+   const LONG prev = InterlockedExchange(&g_AccStep, step);
+   if (why == NULL && prev == step)
+      return;
+   TR_LOG("vram-account pid %lu: %s live %lld MB in %lld allocs; ok %ld, "
+          "pending %ld, alloc failed %ld, resident failed %ld, no queue %ld",
+          (unsigned long)GetCurrentProcessId(), why ? why : "step",
+          (long long)(live >> 20), (long long)g_AccLiveCount, g_AccOk,
+          g_AccPending, g_AccAllocFail, g_AccResFail, g_AccNoQueue);
+}
+
+void
+tritonKmAccountNoteFree(UINT64 bytes)
+{
+   InterlockedAdd64(&g_AccLive, -(LONG64)bytes);
+   InterlockedDecrement64(&g_AccLiveCount);
+   tritonKmAccountReport(NULL);
+}
+
+D3DKMT_HANDLE
+tritonKmCreateAccountAlloc(TRITON_KM *km, UINT64 bytes)
+{
+   if (bytes < TRITON_KM_ACCOUNT_MIN_BYTES || !km->pCallbacks ||
+       !km->pCallbacks->pfnAllocateCb || !tritonKmAccountingEnabled())
+      return 0;
+   if (!tritonKmEnsurePagingQueue(km)) {
+      if (InterlockedIncrement(&g_AccNoQueue) <= 3)
+         tritonKmAccountReport("no paging queue;");
+      return 0;
+   }
+
+   VIOGPU_CREATE_ALLOCATION_EXCHANGE_EX ax;
+   memset(&ax, 0, sizeof(ax));
+   ax.Base.Type = VIOGPU_RESOURCE_TYPE_BLOB;
+   ax.Base.OptionsBlob.blob_mem   = VIOGPU_BLOB_MEM_HOST3D;
+   ax.Base.OptionsBlob.blob_flags = VIOGPU_BLOB_FLAG_RESIDENCY_ONLY |
+                                    VIOGPU_BLOB_FLAG_VRAM_ACCOUNT;
+   ax.Base.OptionsBlob.blob_id    = 0;
+   ax.Base.Size                   = (bytes + 4095ull) & ~4095ull;
+   ax.LookupCookie                = tritonKmMintAllocCookie();
+
+   D3DDDI_ALLOCATIONINFO2 ai;
+   memset(&ai, 0, sizeof(ai));
+   ai.pPrivateDriverData    = &ax;
+   ai.PrivateDriverDataSize = sizeof(ax);
+
+   /* A device allocation (no runtime resource): the runtime never sees it
+    * as part of the app's resource. */
+   D3DDDICB_ALLOCATE cb;
+   memset(&cb, 0, sizeof(cb));
+   cb.NumAllocations   = 1;
+   cb.pAllocationInfo2 = &ai;
+
+   HRESULT hr = km->pCallbacks->pfnAllocateCb(km->hRTDevice, &cb);
+   if (FAILED(hr) || !ai.hAllocation) {
+      if (InterlockedIncrement(&g_AccAllocFail) <= 4)
+         TR_LOG("vram-account pid %lu: allocate (%llu bytes) failed 0x%08lx",
+                (unsigned long)GetCurrentProcessId(),
+                (unsigned long long)bytes, (unsigned long)hr);
+      return 0;
+   }
+
+   /* Nothing ever references this allocation in a DMA buffer, so the
+    * paging fence is not waited on: E_PENDING just means VidMm will make it
+    * resident shortly. */
+   D3DDDI_MAKERESIDENT mr;
+   memset(&mr, 0, sizeof(mr));
+   mr.hPagingQueue   = km->hPagingQueue;
+   mr.NumAllocations = 1;
+   mr.AllocationList = &ai.hAllocation;
+   hr = km->pCallbacks->pfnMakeResidentCb(km->hRTDevice, &mr);
+   if (FAILED(hr) && hr != E_PENDING) {
+      if (InterlockedIncrement(&g_AccResFail) <= 4)
+         TR_LOG("vram-account pid %lu: MakeResident (%llu bytes) failed 0x%08lx",
+                (unsigned long)GetCurrentProcessId(),
+                (unsigned long long)bytes, (unsigned long)hr);
+      D3DDDICB_DEALLOCATE da;
+      memset(&da, 0, sizeof(da));
+      da.NumAllocations = 1;
+      da.HandleList     = &ai.hAllocation;
+      km->pCallbacks->pfnDeallocateCb(km->hRTDevice, &da);
+      return 0;
+   }
+   if (hr == E_PENDING)
+      InterlockedIncrement(&g_AccPending);
+   const LONG ok = InterlockedIncrement(&g_AccOk);
+   InterlockedAdd64(&g_AccLive, (LONG64)bytes);
+   InterlockedIncrement64(&g_AccLiveCount);
+   tritonKmAccountReport(ok == 1 ? "first;" : NULL);
+   return ai.hAllocation;
+}
